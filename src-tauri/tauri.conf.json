{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokvyn",
  "version": "0.1.0",
  "identifier": "io.github.weiki886.lokvyn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lokvyn",
        "width": 1320,
        "height": 820,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": { "active": false }
}
